# Dry-run Polymarket monitor settings for VPS/Docker.
# Copy this file to .env on the VPS. Do not commit real secrets.

PM_MODE=dry_run
POLYMARKET_EXECUTE_LIVE=false

# Per-container memory cap for every Docker service (prevents runaway RAM).
# Budget: (containers you run) x PM_MEM_LIMIT must fit your free RAM. Lower it to pack more
# containers (at OOM-kill risk); raise it for pandas-heavy services. See docs/RUNNING_LEAN.md.
PM_MEM_LIMIT=512m

POLYMARKET_QUERY=world cup
# Optional: scan multiple market families in one local paper cycle. Keep this short on laptops.
# POLYMARKET_SCAN_QUERY_MODE=rotate
# POLYMARKET_QUERIES=world cup,bitcoin,ethereum,solana,xrp,tennis
# POLYMARKET_MAX_SCAN_QUERIES=1
# POLYMARKET_ADAPTIVE_SCAN_PRIORITY=true
POLYMARKET_EVENT_LIMIT=500
POLYMARKET_PUBLIC_SEARCH_ENABLED=true
POLYMARKET_PUBLIC_SEARCH_LIMIT_PER_TYPE=10
POLYMARKET_EVENT_SLUG=
POLYMARKET_TAG_ID=

POLYMARKET_SCAN_SECONDS=270
POLYMARKET_SCAN_INTERVAL_SECONDS=5
POLYMARKET_MIN_EDGE=0.04
POLYMARKET_MAX_SPREAD=0.04
POLYMARKET_MAX_ORDER_USD=5
POLYMARKET_MIN_ASK_SIZE=5
POLYMARKET_MIN_BID_SIZE=5
POLYMARKET_ORDER_TYPE=FOK

POLYMARKET_MODEL_PROBABILITIES_CSV=inputs/polymarket/model_probabilities.csv
POLYMARKET_POSITIONS_CSV=inputs/polymarket/positions.csv
POLYMARKET_OUTPUT_DIR=outputs/polymarket

# Local predictive paper bot loop.
# PAPER_LOOP_ITERATIONS=0 means run continuously inside local Docker.
PAPER_LOOP_ITERATIONS=0
PAPER_LOOP_SLEEP_SECONDS=300

# Leave these blank for dry-run monitoring.
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_PRIVATE_KEY=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# --- docker-compose.live.yml: continuous dry-run stack -----------------------
# Engine config path inside the container (mounted read-only by the compose file).
PM_CONFIG=/app/polymarket_predictive_config.example.yaml

# Dutch-arb execution monitor (REST polling; dry-run; runs continuously).
ARB_POLL_SECONDS=30
ARB_MAX_EVENTS=20
ARB_MIN_ANNUALISED=0.0
ARB_ALERT_ANNUALISED=0.10

# Live mispricing scan (WebSocket-driven; dry-run; looped).
WS_SECONDS=60
MISPRICING_SLEEP_SECONDS=5

# Sharp-odds anchor (Pinnacle/Betfair via The Odds API; dry-run; periodic).
# The Odds API charges credits per request, so refresh hourly by default. Leave the key blank to
# disable fetching (the service idles harmlessly).
THE_ODDS_API_KEY=
SHARP_REFRESH_SECONDS=3600
