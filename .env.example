# Dry-run Polymarket monitor settings for VPS/Docker.
# Copy this file to .env on the VPS. Do not commit real secrets.

PM_MODE=dry_run
POLYMARKET_EXECUTE_LIVE=false

POLYMARKET_QUERY=world cup
POLYMARKET_EVENT_SLUG=
POLYMARKET_TAG_ID=

POLYMARKET_SCAN_SECONDS=270
POLYMARKET_SCAN_INTERVAL_SECONDS=5
POLYMARKET_MIN_EDGE=0.04
POLYMARKET_MAX_SPREAD=0.04
POLYMARKET_MAX_ORDER_USD=5
POLYMARKET_MIN_ASK_SIZE=5
POLYMARKET_MIN_BID_SIZE=5
POLYMARKET_ORDER_TYPE=FOK

POLYMARKET_MODEL_PROBABILITIES_CSV=inputs/polymarket/model_probabilities.csv
POLYMARKET_POSITIONS_CSV=inputs/polymarket/positions.csv
POLYMARKET_OUTPUT_DIR=outputs/polymarket

# Leave these blank for dry-run monitoring.
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_PRIVATE_KEY=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# --- docker-compose.live.yml: continuous dry-run stack -----------------------
# Engine config path inside the container (mounted read-only by the compose file).
PM_CONFIG=/app/polymarket_predictive_config.example.yaml

# Dutch-arb execution monitor (REST polling; dry-run; runs continuously).
ARB_POLL_SECONDS=30
ARB_MAX_EVENTS=20
ARB_MIN_ANNUALISED=0.0
ARB_ALERT_ANNUALISED=0.10

# Live mispricing scan (WebSocket-driven; dry-run; looped).
WS_SECONDS=60
MISPRICING_SLEEP_SECONDS=5
