# VPS Polymarket paper deployment settings.
# Copy to .env on the VPS. Do not commit a real .env file.

# Safety: keep the VPS paper-only.
PM_MODE=scan
POLYMARKET_MODE=scan
POLYMARKET_EXECUTE_LIVE=false
POLYMARKET_LIVE_TRADING=0

# Container memory caps. For Oracle Always Free 2 OCPU / 12 GB, 4g is comfortable.
# For a 4 GB paid VPS, use PM_PAPER_MEM_LIMIT=2g.
PM_PAPER_MEM_LIMIT=4g
PM_DASHBOARD_MEM_LIMIT=256m
SUPERBRU_AUTO_PICK_MEM_LIMIT=1g
# One-shot deploy acceptance; omitted from ordinary compose up.
VPS_DEPLOY_ACCEPTANCE_MEM_LIMIT=2g

# Live websocket/paper cadence.
POLYMARKET_WEBSOCKET_SECONDS=20
PAPER_PREDICTION_CYCLE_SECONDS=30
POLYMARKET_DISCOVERY_CYCLE_SECONDS=180
# 2026-07-12 WO-68b: full governance belongs to vps-ops-scheduler. Running it
# again inside the websocket loop caused deterministic exit-75 restart storms.
POLYMARKET_GOVERNANCE_REFRESH_SECONDS=0
POLYMARKET_DISCOVERY_MAX_RUNTIME_SECONDS=900
POLYMARKET_PREDICTION_MAX_RUNTIME_SECONDS=600
POLYMARKET_GOVERNANCE_MAX_RUNTIME_SECONDS=600
POLYMARKET_LIVE_LOOP_SLEEP_SECONDS=10
POLYMARKET_WEBSOCKET_MAX_ASSETS=120

# Discovery breadth. Keep this bounded; the live loop adapts its target list from governance evidence.
POLYMARKET_QUERY=world cup
POLYMARKET_SCAN_QUERY_MODE=batch
POLYMARKET_QUERIES=
POLYMARKET_MAX_SCAN_QUERIES=8
POLYMARKET_ADAPTIVE_SCAN_PRIORITY=true
POLYMARKET_EVENT_LIMIT=160
POLYMARKET_PUBLIC_SEARCH_ENABLED=true
POLYMARKET_PUBLIC_SEARCH_LIMIT_PER_TYPE=6

# Paper signal defaults.
POLYMARKET_MIN_EDGE=0.04
POLYMARKET_MAX_SPREAD=0.04
POLYMARKET_MAX_ORDER_USD=5
POLYMARKET_MIN_ASK_SIZE=5
POLYMARKET_MIN_BID_SIZE=5

# Dashboard. Public binding is convenient but exposes your strategy/P&L view.
# Prefer a VPS firewall rule or Tailscale. For local-only access, set host to 127.0.0.1.
POLYMARKET_DASHBOARD_HOST=0.0.0.0
POLYMARKET_DASHBOARD_PORT=8765

# Independent probability anchors. THE_ODDS_API_KEY unlocks the sharp-anchor
# pipeline (de-vigged Pinnacle/Betfair fairs) - the highest-priority edge path.
# IMPORTANT: GitHub Actions secrets do NOT propagate to this VPS. Paste the key
# here by hand (free tier: the-odds-api.com), then force-recreate the container:
#   docker compose -f docker-compose.vps-paper.yml up -d --force-recreate polymarket-paper-live
# (a plain restart does not reload env_file). Verify with scripts/check_polymarket_vps_paper.sh.
THE_ODDS_API_KEY=
SHARP_REFRESH_SECONDS=3600

# SuperBru autopicker watchdog. This is a VPS fallback for GitHub scheduler
# drops. It is paper/competition automation only; it does not enable Polymarket
# live trading. Leave credentials blank in git. The deploy workflow can sync
# repository secrets into the VPS .env, or paste these directly on the VPS.
SUPERBRU_AUTO_PICK_ENABLED=true
SUPERBRU_AUTO_PICK_INTERVAL_SECONDS=900
SUPERBRU_AUTO_PICK_WINDOW_MINUTES=5000
SUPERBRU_AUTO_PICK_REVISION_WINDOW_MINUTES=260
SUPERBRU_AUTO_PICK_TIMEOUT_SECONDS=1500
SUPERBRU_AUTO_PICK_OUT_DIR=outputs/pregame_checks/auto_pick_vps
SUPERBRU_EMAIL=
SUPERBRU_USERNAME=
SUPERBRU_PASSWORD=
SUPERBRU_LOGIN_URL=https://www.superbru.com/login
SUPERBRU_POOL_URL=
SUPERBRU_PLAYER_NAME=Danie
SUPERBRU_POOL_KEYWORDS=Moore Infinity,FIFA WC 26,World Cup 2026

# Set by the GitHub deploy workflow so the dashboard can detect stale VPS builds.
PM_VPS_DEPLOYED_SHA=

# WO-68b deploy-capacity floors. Overrides may tighten these values but the
# preflight refuses attempts to loosen the registered 2-vCPU / 6GiB-disk /
# 512MiB-available-memory minimums. It also requires physical RAM at least as
# large as the sum of every Compose mem_limit.
PM_VPS_MIN_VCPUS=2
PM_VPS_MIN_FREE_DISK=6g
PM_VPS_MIN_AVAILABLE_MEMORY=512m

# No wallet/private keys are needed for paper trading.
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_PRIVATE_KEY=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
