+            except (TypeError, ValueError, json.JSONDecodeError):
+                decoded = {}
+        else:
+            decoded = payload if isinstance(payload, dict) else {}
+        if isinstance(decoded, dict):
+            merged = {**order, **decoded}
+            rows.append(merged)
+    return rows
