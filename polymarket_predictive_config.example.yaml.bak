paths:
  data_root: "."
  output_root: "outputs"
  database_path: "work/polymarket/polymarket_engine.sqlite"

categories:
  - all
  - bitcoin
  - crypto
  - election
  - fed
  - finance
  - soccer
  - sports
  - trump
  - worldcup

file_discovery:
  patterns:
    - "outputs/polymarket_wide/**/*"
    - "outputs/polymarket_fixed/**/*"

schema:
  timestamp_fields: [snapshot_timestamp, timestamp, collected_at, updated_at]
  market_id_fields: [market_id, condition_id, id, market_slug, slug]
  token_id_fields: [token_id, asset_id, outcome_token_id]
  required_raw_fields: [snapshot_timestamp, market_id, token_id]

prediction_horizons:
  hours_before_close: [1, 6, 24, 72, 168]
  include_all_valid_snapshots: true

freshness_thresholds:
  collector_stale_minutes: 60
  latest_snapshot_stale_minutes: 30

resolution:
  gamma_base_url: "https://gamma-api.polymarket.com/markets"
  request_timeout_seconds: 20
  request_pause_seconds: 0.05
  max_markets: 250
  settlement_win_threshold: 0.98
  settlement_loss_threshold: 0.02

historical_backfill:
  gamma_base_url: "https://gamma-api.polymarket.com/markets"
  max_closed_markets: 250
  page_size: 100
  request_timeout_seconds: 30
  request_pause_seconds: 0.10
  gamma_query_params: {}

historical_price_history:
  clob_base_url: "https://clob.polymarket.com"
  max_tokens: 500
  interval: "max"
  fidelity_seconds: 300
  request_timeout_seconds: 30
  request_pause_seconds: 0.10

splits:
  method: time_based
  train_fraction: 0.6
  validation_fraction: 0.2
  test_fraction: 0.2

holdout:
  untouched_final_holdout_fraction: 0.1
  minimum_holdout_rows: 100

model:
  type: calibrated_logistic_or_midpoint_shrinkage
  minimum_training_rows: 100
  probability_shrinkage_to_midpoint: 0.35
  random_seed: 20260623

calibration:
  methods: [isotonic, platt, midpoint_shrinkage]
  buckets: 10
  maximum_calibration_error: 0.05

calibration_v2:
  buckets: 10
  minimum_training_rows: 100
  min_rows_per_category: 50
  bucket_shrinkage_to_midpoint: 0.20

baselines:
  include: [midpoint, best_ask_implied, last_price, favourite_market_implied, category_average, no_trade]

external_signals:
  manual_csv_paths: []
  sports_match_confidence_threshold: 0.90
  allow_election_manual_only: true

external_feeds:
  request_timeout_seconds: 30
  feeds: []
  # Example:
  # feeds:
  #   - name: public_macro_calendar
  #     format: csv
  #     path: "data/external/public_macro_calendar.csv"

websocket_market_data:
  url: "wss://ws-subscriptions-clob.polymarket.com/ws/market"
  market_ids: []
  subscription_message: null

paper_edge_simulator:
  minimum_edge: 0.03

backtest:
  execute_at: best_ask
  exit_at: best_bid_or_resolution
  hold_to_resolution: true
  allow_early_exit: false

costs:
  transaction_cost: 0.0
  spread_assumption: 0.02
  slippage: 0.01

risk:
  bankroll: 1000
  minimum_edge: 0.03
  minimum_confidence: 0.65
  maximum_spread: 0.08
  minimum_liquidity: 50
  minimum_time_to_close_minutes: 15
  maximum_resolution_risk: 0.25
  maximum_single_market_exposure: 0.02
  maximum_category_exposure: 0.10
  maximum_correlated_exposure: 0.10
  maximum_daily_loss: 0.03
  maximum_drawdown: 0.10
  maximum_open_orders: 10
  maximum_order_rate_per_minute: 3
  maximum_slippage: 0.02
  kelly_cap: 0.005
  category_blacklist: []
  market_blacklist: []
  event_blacklist: []

paper_trading:
  enabled: true
  starting_cash: 1000
  persist_orders: true

trading:
  mode: paper

live_trading:
  enabled: false
  approval_file: "config/polymarket_live_approval.yaml"
  require_env_var: "POLYMARKET_LIVE_TRADING"
  require_kill_switch_clear: true
  limit_orders_only: true

governance_thresholds:
  min_training_rows: 100
  min_validation_rows: 100
  min_resolved_markets: 100
  min_snapshots_per_market: 5
  maximum_data_quality_blockers: 0
  require_paper_trading_evidence: true
